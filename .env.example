# TaskFlow-Todoist — Environment Variables
# Copy to .env and fill in values. Do NOT commit .env with real values.

# AI Document Reference Signing Secret (required for production)
# Used to HMAC-sign document references so the server can verify
# that document context was issued by a real /document-roadmap response
# and not forged by the browser.
#
# Requirements:
#   - Minimum 32 random bytes (64 hex characters recommended)
#   - Must be stable across server restarts (do NOT use random per-process fallback in production)
#   - Must NOT be shared with the frontend or exposed in any API
#   - Generate with: openssl rand -hex 32
#
AI_DOC_SIGN_SECRET=

# Optional: override AI provider timeout (ms)
# AI_CHAT_TIMEOUT_MS=120000

# Optional: override Gemini API key
# GEMINI_API_KEY=

# Optional: override OpenAI API key
# OPENAI_API_KEY=
